# NAME: NetDisk_Download
# DESC: 网盘下载专用规则集 (MediaFire + Gofile), Clash classical 格式
# DOMAIN: 0
# DOMAIN-KEYWORD: 0
# DOMAIN-SUFFIX: 4
# IP-ASN: 0
# IP-CIDR: 0
# TOTAL: 4
# UPDATED: 2026-10-24
